{
  "name": "lacostume",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx serve .",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');for(const f of fs.readdirSync('.').filter(f=>f.endsWith('.html')))fs.copyFileSync(f,'dist/'+f);fs.cpSync('assets','dist/assets',{recursive:true});\""
  }
}
